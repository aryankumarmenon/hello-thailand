{
  "name": "hello-thailand",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deploy": "playwright test -c playwright.deploy.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-content": "tsx scripts/validate-content.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate-content && pnpm format:check",
    "privacy-lint": "tsx scripts/privacy-lint.ts",
    "import:places": "tsx scripts/import-csv.ts",
    "geocode": "tsx scripts/geocode.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
